{
  "configured": true,
  "url": "https://hike-teaching-center.polymas.com/custom-stu-hike/agent-course-hike/ai-course-center",
  "frame_url_contains": "",
  "model": "deepseek-flash",
  "target": 90,
  "max_rounds": 10,
  "max_api_calls": 100,
  "max_minutes": 60,
  "timeout_seconds": 45,
  "result_settle_seconds": 1.0,
  "zero_score_grace_seconds": 8.0,
  "refresh_zero_result": true,
  "action_delay_seconds": 0.7,
  "min_confidence": 0.6,
  "low_confidence_action": "continue",
  "keep_browser_on_error": true,
  "auto_next": true,
  "next_scope": "course",
  "browser": "msedge",
  "selectors": {
    "question": ".questionContent",
    "stem": ".questionName .centent-pre",
    "type": ".questionTitle .letterSortNum",
    "option": ".radio-view > li, .checkbox-view > li, .checkbox-view > label.el-checkbox",
    "option_text": ".stem, .el-checkbox__label .preStyle",
    "selected": ".checkedIcon, input:checked, .is-checked, [aria-checked='true']",
    "answer_input": "textarea, input[type='text']",
    "next": ".pre-next .next-topic:not(.noNext)",
    "submit": ".right-H .reviewDone",
    "confirm": "",
    "result": ".line1-left",
    "mastery": ".charts-label-rate",
    "result_total": ".line1-count-total:first-child .line1-count-total-num",
    "review": ".line1-count-link",
    "review_root": ".exam-preview",
    "review_question": ".question-item",
    "review_stem": ".quest-title .option-name",
    "review_type": ".quest-type",
    "review_option": ".el-radio, .el-checkbox",
    "review_option_text": ".preStyle",
    "correct_answer": ".analysis .answer-title",
    "correct_marker": ".question-result:has-text(\"回答正确\")",
    "wrong_marker": ".question-result:has-text(\"回答错误\")",
    "review_next": "",
    "review_close": "",
    "retry": ".exam-preview .submit"
  }
}
